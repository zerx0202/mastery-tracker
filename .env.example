# Klucz do Riot API. Personal Key wygasa co 24 h, Production jest staly.
# https://developer.riotgames.com/
RIOT_API_KEY=

# Riot ID rozbite na czesci (Nazwa#TAG) - stad brany jest PUUID przy starcie.
MY_RIOT_NAME=
MY_RIOT_TAG=

# Platforma konta (euw1, eun1, na1...) i region routingu (europe, americas,
# asia). Kod czyta RIOT_PLATFORM/RIOT_REGION - stare nazwy PLATFORM/REGION
# nie byly czytane przez nic i odtworzenie serwera z przykladu padalo
# na KeyError (audyt 2.09).
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# Tryb, ktory sledzimy. KIWI to ARAM Mayhem (queueId 2400).
DEFAULT_MODE=KIWI

# Tryby pomijane w statystykach, po przecinku. JADE to league classic na boty.
EXCLUDED_MODES=JADE

# Docelowy szczebel maestrii (misja: milestone 4).
GOAL_MILESTONE=4

# Token chroniacy endpointy zapisujace (POST/PUT/DELETE) oraz GET /api/export
# (pelny zrzut bazy). Pusty = brak ochrony, sensowne tylko w sieci domowej
# lub w tailnecie.
# Gdy ustawiony, agent musi wysylac naglowek X-API-Token o tej samej wartosci.
API_TOKEN=

# UID:GID, jako ktore chodzi proces w kontenerze (bez roota). Musza umiec
# pisac po ./data na hoscie. Domyslnie 501:20 = pierwszy uzytkownik macOS;
# sprawdz swoje przez `id -u` i `id -g`, ustaw tylko gdy inne.
APP_UID=501
APP_GID=20
