# ============================================================
#  Mastery Tracker - zmienne srodowiskowe
#  Skopiuj jako .env i uzupelnij. .env jest w .gitignore.
# ============================================================

# --- Riot API ---

# Klucz z developer.riotgames.com. Personal API Key nie wygasa;
# klucz deweloperski trzeba regenerowac co 24 h.
# Po zmianie klucza konieczny restart kontenera - zmienne wczytuja sie przy starcie.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Platforma konta - decyduje o hoscie dla summoner-v4, league-v4, champion-mastery-v4.
# euw1, eun1, na1, kr, br1, ...
RIOT_PLATFORM=euw1

# Region kontynentalny - decyduje o hoscie dla account-v1 i match-v5.
# europe, americas, asia, sea
RIOT_REGION=europe


# --- konto ---

# Riot ID rozbity na czesci. Nick wpisz surowo, ze spacjami i znakami
# specjalnymi - kodowanie do URL robi backend.
# PUUID jest wyliczany z tego i cache'owany w bazie, bo jest szyfrowany
# per klucz API i po zmianie klucza traci waznosc.
MY_RIOT_NAME=Jerzy Epsztajn
MY_RIOT_TAG=1723


# --- cel i tryby ---

# Milestone, do ktorego liczona jest sciezka w /api/targets.
# Misja z przepustki wymaga milestone 4 na jednym championie.
GOAL_MILESTONE=4

# Tryb, wedlug ktorego licza sie statystyki (winrate, KDA) w scoringu.
# KIWI = ARAM Mayhem, ARAM = zwykly ARAM, CLASSIC = Summoner's Rift.
# Puste = wszystkie tryby razem.
DEFAULT_MODE=KIWI

# Tryby wykluczone ze statystyk, po przecinku.
# JADE = "league classic" (gry na boty pod przepustke, przesuniete championId).
EXCLUDED_MODES=JADE


# --- opcjonalne ---

# Sciezka pliku bazy WEWNATRZ kontenera. Katalog jest montowany z hosta
# przez wolumen ./data, wiec domyslna wartosc pasuje do docker-compose.yml.
# DB_PATH=/code/data/mastery.db
