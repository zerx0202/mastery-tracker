# Klucz do Riot API. Personal Key wygasa co 24 h, Production jest staly.
# https://developer.riotgames.com/
RIOT_API_KEY=

# Riot ID w formacie Nazwa#TAG - stad brany jest PUUID przy starcie.
RIOT_ID=

# Platforma konta (euw1, eun1, na1...) i region routingu (europe, americas, asia).
PLATFORM=euw1
REGION=europe

# Tryb, ktory sledzimy. KIWI to ARAM Mayhem (queueId 2400).
DEFAULT_MODE=KIWI

# Tryby pomijane w statystykach, po przecinku. JADE to league classic na boty.
EXCLUDED_MODES=JADE

# Docelowy szczebel maestrii (misja: milestone 4).
GOAL_MILESTONE=4

# Token chroniacy endpointy zapisujace (POST/PUT/DELETE).
# Pusty = brak ochrony, sensowne tylko w sieci domowej lub w tailnecie.
# Gdy ustawiony, agent musi wysylac naglowek X-API-Token o tej samej wartosci.
API_TOKEN=
